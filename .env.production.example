# ===== Production: cp .env.production.example .env rồi điền các giá trị <...> =====
APP_NAME="Nhà Hàng"
APP_ENV=production
# Tạo: docker compose -f compose.prod.yaml run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Domain khách truy cập (QR in ra trỏ về đây). Có SSL thì dùng https://
APP_URL=https://<domain>
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Nginx: domain để cấp SSL Let's Encrypt (make prod-ssl), cổng mở ra ngoài
SERVER_NAME=<domain>
LETSENCRYPT_EMAIL=<email nhận thông báo hết hạn SSL>
HTTP_PORT=80
HTTPS_PORT=443
# Đặt "*" nếu chạy sau Cloudflare / load balancer (SSL kết thúc ở proxy)
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nha_hang
DB_USERNAME=nha_hang
DB_PASSWORD=<mật khẩu mạnh>
DB_ROOT_PASSWORD=<mật khẩu root mạnh>
MYSQL_BUFFER_POOL=512M

SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true khi chạy HTTPS
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=nha_hang_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=<mật khẩu redis>
REDIS_PORT=6379
REDIS_PREFIX=nha_hang_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@<domain>"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=nha-hang
# Chuỗi ngẫu nhiên (key được nhúng vào JS, secret thì không)
REVERB_APP_KEY=<chuỗi ngẫu nhiên>
REVERB_APP_SECRET=<chuỗi ngẫu nhiên khác>
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Webhook SePay (URL: APP_URL/webhooks/sepay, chứng thực API Key)
SEPAY_WEBHOOK_KEY=

# Sao lưu: giờ chạy hằng ngày, số ngày giữ, thư mục trên máy chủ
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups

# Chạy migrate tự động khi container app khởi động (deploy.sh đã chạy migrate, nên để false)
AUTO_MIGRATE=false
PHP_FPM_MAX_CHILDREN=20

# Bản demo chỉ xem (config/demo.php): chặn mọi thao tác ghi từ web, hiện nút "Demo" kèm tài khoản đăng nhập sẵn,
# tự dựng lại dữ liệu mẫu (php artisan demo:reset) mỗi ngày lúc DEMO_RESET_AT (nhiều mốc: "04:00,11:00,17:00"
# để bàn đang phục vụ / màn hình bếp luôn mới trong giờ khách xem). Website thật để false.
DEMO_MODE=false
DEMO_RESET_AT=04:00
