APP_NAME="Nhà Hàng"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Domain / IP khách truy cập (mã QR in ra trỏ về đây). Test bằng điện thoại trong LAN: http://<IP máy>:8090
APP_URL=http://localhost:8090
# Cổng nginx trên máy host (production: 80). Máy dev đang có Apache chiếm 80 nên dùng 8090.
APP_PORT=8090

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nha_hang
DB_USERNAME=nha_hang
DB_PASSWORD=secret
FORWARD_DB_PORT=3309

SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=nha_hang_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=nha_hang_
FORWARD_REDIS_PORT=6380

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@nhahang.test"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb: app/horizon gửi broadcast tới container reverb:8080 (nội bộ docker).
REVERB_APP_ID=nha-hang
REVERB_APP_KEY=nhahangkey
REVERB_APP_SECRET=nhahangsecret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Trình duyệt kết nối WebSocket qua nginx, cùng host / cổng với trang (xem resources/js/echo.js).
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"

# Webhook SePay: tự xác nhận chuyển khoản. Đặt cùng API Key khi tạo webhook trên my.sepay.vn (URL: APP_URL/webhooks/sepay).
SEPAY_WEBHOOK_KEY=

# Bản demo chỉ xem (config/demo.php): chặn mọi thao tác ghi từ web, hiện nút "Demo" kèm tài khoản đăng nhập sẵn,
# tự dựng lại dữ liệu mẫu (php artisan demo:reset) mỗi ngày lúc DEMO_RESET_AT (nhiều mốc: "04:00,11:00,17:00"
# để bàn đang phục vụ / màn hình bếp luôn mới trong giờ khách xem). Website thật để false.
DEMO_MODE=false
DEMO_RESET_AT=04:00
